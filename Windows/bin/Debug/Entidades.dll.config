<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="di.financiera.entidades.My.MySettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <system.diagnostics>
        <sources>
            <!-- En esta sección se define la configuración del registro para My.Application.Log -->
            <source name="DefaultSource" switchName="DefaultSwitch">
                <listeners>
                    <add name="FileLog" />
                    <!-- Quite los comentarios de la sección posterior para escribir en el registro de eventos de la aplicación -->
                    <!--<add name="EventLog"/>-->
                </listeners>
            </source>
        </sources>
        <switches>
            <add name="DefaultSwitch" value="Information" />
        </switches>
        <sharedListeners>
            <add name="FileLog" type="Microsoft.VisualBasic.Logging.FileLogTraceListener, Microsoft.VisualBasic, Version=8.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL" initializeData="FileLogWriter" />
            <!-- Quite los comentarios de la sección posterior y reemplace APPLICATION_NAME con el nombre de su aplicación para escribir en el registro de eventos de la aplicación -->
            <!--<add name="EventLog" type="System.Diagnostics.EventLogTraceListener" initializeData="APPLICATION_NAME"/> -->
        </sharedListeners>
    </system.diagnostics>
    <applicationSettings>
        <di.financiera.entidades.My.MySettings>
            <setting name="Entidades_SiisaWebService_CustomerInfo" serializeAs="String">
                <value>http://www.siisa.com.ar/service/siisainfo.asmx</value>
            </setting>
            <setting name="Entidades_RiesgoNetFiltrarWebService_variables_rn" serializeAs="String">
                <value>http://ws.riesgonet.com/variablesrn/index.php</value>
            </setting>
            <setting name="Entidades_RiesgoNetFiltrar2WebService_variables_rn" serializeAs="String">
                <value>http://ws.riesgonet.com/variablesrn/index.php</value>
            </setting>
            <setting name="Entidades_wsaa_LoginCMSService" serializeAs="String">
                <value>https://wsaa.afip.gov.ar/ws/services/LoginCms</value>
            </setting>
            <setting name="Entidades_wsFacturacion_Service" serializeAs="String">
                <value>https://servicios1.afip.gov.ar/wsfev1/service.asmx</value>
            </setting>
            <setting name="Entidades_ServicioSMSMasivo_SMSMasivosAPI" serializeAs="String">
                <value>http://servicio.smsmasivos.com.ar/ws/SMSMasivosAPI.asmx</value>
            </setting>
            <setting name="Entidades_ServicioMutual_CreditosService" serializeAs="String">
                <value>http://mutualaman.com/sigem/service/call/creditos</value>
            </setting>
            <setting name="Entidades_CodeneWebService_ServicioCodene" serializeAs="String">
                <value>http://www.codene.com.ar:8585/servicioweb/ServicioCodene.asmx</value>
            </setting>
            <setting name="Entidades_MotorSiisaWebService_Service1" serializeAs="String">
                <value>http://motor.siisa.com.ar/requestservice/service.asmx</value>
            </setting>
            <setting name="Entidades_MotorBCRAWebService_ConsultaMotorBCRA" serializeAs="String">
                <value>http://localhost:54891/ConsultaMotorBCRA.asmx</value>
            </setting>
            <setting name="Entidades_EquifaxWebServiceUY_wsProductos" serializeAs="String">
                <value>https://www.clearing.com.uy/wsproductos/wsproductos.wsdl</value>
            </setting>
            <setting name="Entidades_EquifaxWebServicePY_WSExperto" serializeAs="String">
                <value>https://www.equifax.com.py/WSExperto/WSExperto.asmx</value>
            </setting>
            <setting name="Entidades_Bridge_BridgeCoreSOAPService" serializeAs="String">
                <value>http://200.59.130.99:19380/bridge/services/bridgeCoreSOAP</value>
            </setting>
        </di.financiera.entidades.My.MySettings>
    </applicationSettings>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="ServiciosInformesSOAP11Binding" />
                <binding name="BasicHttpBinding_IWS_Informacion" closeTimeout="00:05:00" openTimeout="00:05:00" receiveTimeout="00:20:00" sendTimeout="00:05:00" />
                <binding name="BasicHttpBinding_IWS_Informacion1" />
                <binding name="AdaptorClientBinding" />
                <!--<binding name="AdaptorClientBinding" />-->
            </basicHttpBinding>
            <customBinding>
                <binding name="ServiciosInformesSOAP12Binding">
                    <textMessageEncoding messageVersion="Soap12" />
                    <httpTransport />
                </binding>
            </customBinding>
            <wsHttpBinding>
                <binding name="WSHttpBinding_IAutogestion" />
            </wsHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://www.infolin.com.ar:80/InformeScoring/services/ServiciosInformes" binding="basicHttpBinding" bindingConfiguration="ServiciosInformesSOAP11Binding" contract="InfolinWebServices.ServiciosInformesPortType" name="ServiciosInformesSOAP11port_http" />
            <endpoint address="http://www.infolin.com.ar:80/InformeScoring/services/ServiciosInformes" binding="customBinding" bindingConfiguration="ServiciosInformesSOAP12Binding" contract="InfolinWebServices.ServiciosInformesPortType" name="ServiciosInformesSOAP12port_http" />
            <endpoint address="http://divinf.dnsalias.com/ServiciosBureauWCF/Autogestion.svc/basic" binding="wsHttpBinding" bindingConfiguration="WSHttpBinding_IAutogestion" contract="WCFAutogestionEntidades.IAutogestion" name="WSHttpBinding_IAutogestion">
                <identity>
                    <dns value="divinf.dnsalias.com" />
                </identity>
            </endpoint>
            <endpoint address="http://bsmart.com.ar:25500/ws_ces_security/WS_Informacion.svc" binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IWS_Informacion" contract="MotorBeSmartWebService.IWS_Informacion" name="BasicHttpBinding_IWS_Informacion" />
            <endpoint address="http://10.113.200.2:8080/WsExecute/WsExecute/WsExecute.asmx" binding="basicHttpBinding" bindingConfiguration="AdaptorClientBinding" contract="BCUWebService.AdaptorClientBinding" name="AdaptorClientBinding" />
        </client>
    </system.serviceModel>
<startup>
  <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" /></startup>
  <runtime>
